<?xml version="1.0" encoding="utf-8"?>
<!-- File for reusable styles within the application -->
<resources>
    <!-- default header text styling (TextView) -->
    <style name="HeaderFontStyle">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:typeface">sans</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- default text styling  -->
    <style name="DefaultFontStyle">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:typeface">sans</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- default  text styling  for input fields -->
    <style name="inputFontStyle">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:typeface">sans</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- default button text styling  -->
    <style name="ButtonFontStyle">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:typeface">sans</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>

    </style>
    <!-- set image delete button background color and size dimensions -->
    <style name="imageButtonStyle">
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_marginHorizontal">5dp</item>
        <item name="android:layout_marginVertical">5dp</item>

        <item name="android:background">@drawable/rounded_button</item>

    </style>

    <!-- styling for Edit button image-->
    <style name="editImageStyle">
        <item name="android:tint">@color/blue</item>
        <item name="android:background">@color/white</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_marginLeft">10dp</item>
    </style>

    <!-- styling for FAB add new item button -->
    <style name="fabStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>

    </style>
</resources>